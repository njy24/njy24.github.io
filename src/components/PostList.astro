---
import type { CollectionEntry } from 'astro:content';
import { path, date } from '../site';
import { minutes, postPath } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map(post => <article class="post-row">
    <div class="post-date"><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time><span>{minutes(post)} 分钟阅读</span></div>
    <div class="post-body"><div class="post-meta">{post.data.example && <span class="example-label">示例文章</span>}{post.data.tags.map(tag => <a class="tag-link" href={path(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div><h2><a href={postPath(post)}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
  </article>)}
</div>
