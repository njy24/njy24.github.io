---
import Base from '../layouts/Base.astro';
import Activities from '../components/Activities.astro';
import Projects from '../components/Projects.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/posts';
import { site, path } from '../site';
const all = await posts();
---
<Base>
  <section class="home-section" aria-labelledby="introduction">
    <h1 id="introduction">个人简介</h1>
    <p>{site.author}</p>
    {site.introduction && <p class="introduction-text">{site.introduction}</p>}
    <p>GitHub：<a href={site.github}>github.com/njy24</a></p>
    <div class="detail-link"><a href={path('about/')}>详细</a></div>
  </section>
  <section class="home-section" aria-labelledby="activities">
    <h2 id="activities">近期活动</h2>
    <Activities limit={5} />
    <div class="detail-link"><a href={path('activities/')}>全部动态</a></div>
  </section>
  <section class="home-section" aria-labelledby="projects">
    <h2 id="projects">近期项目</h2>
    <Projects limit={5} />
    <div class="detail-link"><a href={path('projects/')}>全部项目</a></div>
  </section>
  {all.length > 0 && <section class="home-section" aria-labelledby="articles"><h2 id="articles">最近文章</h2><PostList posts={all.slice(0, 5)} /><div class="detail-link"><a href={path('archive/')}>全部文章</a></div></section>}
  <section class="home-section" aria-labelledby="contact">
    <h2 id="contact">联系方式</h2>
    <p><strong>GitHub：</strong><a href={site.github}>@njy24</a></p>
    <div class="detail-link"><a href={path('contact/')}>详细</a></div>
  </section>
</Base>
