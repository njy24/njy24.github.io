---
import Base from '../../layouts/Base.astro';
import { posts } from '../../lib/posts';
import { path } from '../../site';
const all = await posts();
const tags = [...new Set(all.flatMap(p => p.data.tags))].sort((a,b) => a.localeCompare(b, 'zh'));
---
<Base title="标签"><section class="page-section"><h1>标签</h1>{tags.length === 0 && <p class="empty">暂无标签。</p>}<div class="tag-grid">{tags.map(tag => <a href={path(`tags/${encodeURIComponent(tag)}/`)}><span>{tag}</span><span>{all.filter(p => p.data.tags.includes(tag)).length} 篇</span></a>)}</div></section></Base>
