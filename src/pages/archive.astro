---
import Base from '../layouts/Base.astro';
import { posts, postPath } from '../lib/posts';
import { date } from '../site';
const all = await posts();
const years = [...new Set(all.map(p => p.data.date.getUTCFullYear()))];
---
<Base title="文章归档"><section class="page-intro"><p class="eyebrow">ARCHIVE</p><h1>文字的足迹。</h1><p>共 {all.length} 篇文章，按时间慢慢积累。</p></section>{years.map(year => <section class="archive-year"><h2>{year}</h2><ul>{all.filter(p => p.data.date.getUTCFullYear() === year).map(p => <li><time datetime={p.data.date.toISOString()}>{date(p.data.date).slice(5)}</time><a href={postPath(p)}>{p.data.title}</a>{p.data.example && <span class="example-label">示例</span>}</li>)}</ul></section>)}</Base>
