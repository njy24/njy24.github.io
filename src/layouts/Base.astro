---
import { site, path } from '../site';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; noindex?: boolean; }
const { title, description = site.description, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const nav = [
  { label: '首页', url: '' },
  { label: '个人简介', url: 'about/' },
  { label: '文章', url: 'archive/' },
  { label: '动态', url: 'activities/' },
  { label: '项目', url: 'projects/' },
  { label: '联系', url: 'contact/' },
  { label: '搜索', url: 'search/' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={path('rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header">
      <nav class="navigation" aria-label="主导航">
        {nav.map(item => <a href={path(item.url)} aria-current={current === path(item.url) ? 'page' : undefined} aria-label={item.url === 'search/' ? '搜索文章' : undefined}>{item.label}</a>)}
      </nav>
      <div class="nav-tools">
        <button id="theme-toggle" aria-label="切换到深色主题">深色</button>
        <a href={site.github} rel="me">GitHub</a>
      </div>
    </header>
    <main id="main" class="main-content"><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span><span class="footer-separator" aria-hidden="true">|</span><a href={site.github}>GitHub</a><span class="footer-separator" aria-hidden="true">|</span><a href={path('rss.xml')}>RSS 订阅</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function syncThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (toggle) {
          toggle.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题');
          toggle.textContent = dark ? '浅色' : '深色';
        }
      }
      syncThemeLabel();
      toggle?.addEventListener('click', () => {
        const value = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = value;
        try { localStorage.setItem('theme', value); } catch {}
        syncThemeLabel();
      });
    </script>
  </body>
</html>
