---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { posts, minutes, postPath } from '../lib/posts';
import { site, path, date } from '../site';
export async function getStaticPaths() {
  const all = await posts();
  return all.map((post, i) => ({ params: { post: (post.data.permalink ?? `/posts/${post.id}/`).replace(/^\/|\/$/g, '') }, props: { post, next: all[i + 1] } }));
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description} article>
  <article class="reading"><header class="article-header"><a class="text-link" href={path('archive/')}>全部文章</a><div class="post-meta">{post.data.example && <span class="example-label">示例文章</span>}{post.data.tags.map(tag => <a href={path(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><span>{site.author}</span><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time><span>{minutes(post)} 分钟阅读</span></div>{post.data.updated && <p class="updated">更新于 {date(post.data.updated)}</p>}</header>
  {headings.some(h => h.depth === 2) && <details class="toc"><summary>文章目录</summary><ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}
  <div class="prose"><Content /></div>
  <div class="article-end"><span>写到这里，谢谢阅读。</span><button class="text-button" id="copy-link">复制文章链接</button><span id="copy-status" role="status"></span></div>
  {next && <a class="next-post" href={postPath(next)}><span>继续阅读</span><strong>{next.data.title}</strong></a>}
  </article>
  <script>
    document.querySelector('#copy-link')?.addEventListener('click', async () => {
      const status = document.querySelector('#copy-status');
      try { await navigator.clipboard.writeText(location.href); if (status) status.textContent = '已复制'; }
      catch { if (status) status.textContent = '请从地址栏复制链接'; }
    });
  </script>
</Base>
