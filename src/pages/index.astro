---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/posts';
import { site, path } from '../site';
const all = await posts();
---
<Base>
  <section class="intro"><p class="eyebrow">A PERSONAL JOURNAL</p><h1>{site.title}</h1><p class="intro-description">{site.description}<br />把零散的思考，整理成可以重读的文字。</p><a class="text-link" href={path('about/')}>关于这个小站</a><span class="intro-stamp" aria-hidden="true">慢<br />记</span></section>
  <section aria-labelledby="latest"><div class="section-heading"><h2 id="latest">最近的文字 <span>{all.length.toString().padStart(2, '0')}</span></h2><a href={path('archive/')}>全部归档</a></div><PostList posts={all.slice(0, 8)} />{all.length === 0 && <p class="empty">第一篇文章正在路上。</p>}</section>
  <aside class="subscribe"><div><h2>偶尔更新，认真记录。</h2><p>通过 RSS 订阅，在你喜欢的阅读器里相遇。</p></div><a class="outline-link" href={path('rss.xml')}>订阅 RSS <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="5" cy="19" r="1" fill="currentColor"/><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/></svg></a></aside>
</Base>
