---
import Base from '../layouts/Base.astro';
import { posts, postPath } from '../lib/posts';
import { date, path } from '../site';
const all = await posts();
const years = [...new Set(all.map(p => p.data.date.getUTCFullYear()))];
---
<Base title="文章"><section class="page-section"><div class="page-heading"><h1>文章</h1><a href={path('tags/')}>按标签浏览</a></div>{all.length === 0 && <p class="empty">暂无文章。</p>}{years.map(year => <section class="archive-year"><h2>{year}</h2><ul>{all.filter(p => p.data.date.getUTCFullYear() === year).map(p => <li><time datetime={p.data.date.toISOString()}>{date(p.data.date).slice(5)}</time><a href={postPath(p)}>{p.data.title}</a></li>)}</ul></section>)}</section></Base>
